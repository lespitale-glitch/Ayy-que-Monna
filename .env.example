# Copiar este archivo como .env.local y completar con los datos de tu proyecto de Supabase
# (Supabase → Project Settings → API). .env.local NO se sube a Git.

# Project URL, ej: https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=

# Clave pública: "anon public" (proyectos clásicos) o "publishable key" (sb_publishable_...).
# ⚠️ NUNCA usar aquí la "service_role" / "secret" key: da acceso total a la base de datos.
VITE_SUPABASE_ANON_KEY=
